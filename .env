# ──────────────────────────────────────────────────────────────
# MARVEL.WTF — your local .env  (git-ignored, never commit)
# BETTER_AUTH_SECRET below is a generated DEV secret — make a new one for production.
# ──────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / local).
DATABASE_URL=postgresql://marvel:marvel@localhost:5432/marvelwtf

# Signs sessions & tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=DDiRYmIIMyCKpRQbuFTXF6YkfE3NT85DLHS/IJWukYM=

# Public base URL of the app (no trailing slash).
# Local: http://localhost:3000   Production: https://marvel.wtf
BETTER_AUTH_URL=http://localhost:3000

# ── OPTIONAL: SOCIAL LOGIN (button appears automatically when BOTH values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── OPTIONAL: EMAIL (password reset + verification) ───────────
# Without these, emails are printed to the server console in dev.
RESEND_API_KEY=
EMAIL_FROM="MARVEL.WTF <no-reply@marvel.wtf>"
# Set to "true" to block login until the email is verified (needs RESEND_API_KEY).
REQUIRE_EMAIL_VERIFICATION=false

# ── OPTIONAL: EXTRA ──────────────────────────────────────────
# Comma-separated extra origins allowed to call the auth API (e.g. preview URLs).
TRUSTED_ORIGINS=
